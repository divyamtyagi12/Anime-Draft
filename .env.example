# ───────── REQUIRED ─────────
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-botfather-token
# Supabase project URL, e.g. https://xxxxxxxx.supabase.co   (NOT a postgresql:// connection string)
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase *service_role* key (server-side only! never commit, never ship to a frontend)
SUPABASE_KEY=your-supabase-service-role-key

# ───────── OPTIONAL ─────────
# polling (default, local dev) or webhook (production)
RUN_MODE=polling
# Webhook mode only
WEBHOOK_URL=
WEBHOOK_PATH=anime-draft-webhook
WEBHOOK_SECRET=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8443

# Anime Draft tuning
MIN_PLAYERS=3
MAX_PLAYERS=8
# Seconds between clash reveals in battle DMs
CLASH_DELAY=2.0
# Idle drafters are auto-picked after this many minutes (0 = disabled)
DRAFT_TIMEOUT_MINUTES=20

# Number Wars tuning
NW_MIN_PLAYERS=3
NW_MAX_PLAYERS=20
# Seconds players have to lock a number each round
NW_ROUND_SECONDS=30
# Auto-start this many seconds after the minimum player count is reached (0 = host/admin starts only)
NW_LOBBY_COUNTDOWN=60
# Hard cap on match length; survivors are ranked by HP → round wins → total distance
NW_MAX_ROUNDS=30
# Pause between a round's results and the next round
NW_BETWEEN_ROUNDS=4.0

# Upsert character data from data/characters.py into Supabase on every start
AUTO_SEED=true
# Comma-separated Telegram user ids allowed to use /setimage
OWNER_IDS=
LOG_LEVEL=INFO
